# Copy to .env.local and fill in. Never commit real keys.

# Required: your Groq API key (https://console.groq.com/keys). Server-side only.
GROQ_API_KEY=

# Optional: the Groq chat model to use. Defaults to openai/gpt-oss-120b.
# Any Groq chat model id works, e.g. llama-3.3-70b-versatile.
GROQ_MODEL=openai/gpt-oss-120b

# Optional: limits on model calls, to protect the key on a public demo.
# Set any of them to 0 to turn that limit off. Fixed safety replies are never limited.
# Counts are kept in server memory (best-effort on serverless hosts) and reset at 00:00 UTC.
# Model replies per client IP per minute
RATE_LIMIT_PER_MINUTE=10
# Model replies per client IP per day
DAILY_LIMIT_PER_IP=100
# Model replies across all users per day
DAILY_LIMIT_TOTAL=1000
