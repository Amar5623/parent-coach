# Copy to .env.local and fill in. Never commit real keys.

# Required: your Groq API key (https://console.groq.com/keys). Server-side only.
GROQ_API_KEY=

# Optional: the Groq chat model to use. Defaults to openai/gpt-oss-120b.
# Any Groq chat model id works, e.g. llama-3.3-70b-versatile.
GROQ_MODEL=openai/gpt-oss-120b
